---
import type { Activity } from '../data/activities';

interface Props {
    activity: Activity;
}

const { activity } = Astro.props;
---

<div class="relative group activity-card">
    <div class="absolute inset-0 bg-gradient-to-r from-green-500 to-cyan-500 rounded-xl opacity-20 blur-2xl group-hover:opacity-30 transition-opacity"></div>
    <div class="flex flex-row gap-4 backdrop-blur-sm bg-slate-900 p-4 rounded-xl ">
        <div class="flex-col gap-6 items-center justify-center">
            <div class="flex flex-row justify-between gap-10">
            <div class="flex flex-row gap-3 justify-center items-center">
                
                    <img class="rounded-full object-cover w-12 h-12 sm:w-16 sm:h-16 md:w-20 md:h-20 border border-neutral-900 flex-shrink-0" src={activity.logo}/>
                
                <h5 class="text-white">{activity.name}</h5>
            </div>
            <div class="flex flex-col gap-2 items-center">
                <span class="text-green-500 font-bold">{activity.year}</span>
                <span class="text-purple-500 text-sm">{activity.category}</span>
            </div>
            </div>
              { activity.image 
              &&
              <div class="my-4">
               <img class="w-full h-48 sm:h-56 md:h-64 object-contain rounded-lg" src={activity.image}/> 
            </div>}
            <div class="my-4">
                <p class="text-[14px]">{activity.description}</p>
            </div>
        </div>
    </div>
</div>

<style>
    .activity-card {
        @apply transition-transform transform hover:scale-105;
    }
</style>