---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, author } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead 
            title={title} 
            description={description} 
            image={heroImage}
        />
    </head>
    <body class="bg-neutral-950 text-neutral-100 font-sans antialiased leading-relaxed">
        <Header />
        <main class="container mx-auto px-6 md:px-12">
            <article class="max-w-5xl mx-auto">
                <!-- Hero Section -->
                <div class="py-24 md:py-32">
                    {heroImage && (
                        <div class="relative w-full h-[400px] md:h-[500px] mb-12 rounded-2xl overflow-hidden shadow-xl">
                            <img 
                                src={heroImage} 
                                alt="" 
                                class="absolute inset-0 w-full h-full object-cover"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/60 to-transparent"></div>
                        </div>
                    )}
                    
                    <div class="space-y-8">
                        <!-- Author Section -->
                        <div class="flex items-center gap-4 p-5 border border-neutral-800 rounded-lg bg-neutral-900/50">
                            <img 
                                src={author.avatar} 
                                alt={author.name}
                                class="w-14 h-14 rounded-full object-cover border-2 border-rose-500"
                            />
                            <div>
                                <h5 class="text-xl font-semibold"><a href="/about" class="hover:text-rose-500">{author.name}</a></h5>
                                <p class="text-base text-rose-400">{author.role}</p>
                            </div>
                        </div>

                        <!-- Post Meta -->
                        <div class="flex items-center gap-4 text-neutral-400 text-base">
                            <FormattedDate date={pubDate} />
                            {updatedDate && (
                                <span class="flex items-center gap-2">
                                    <span class="text-rose-500">•</span> Updated: <FormattedDate date={updatedDate} />
                                </span>
                            )}
                        </div>
                        
                        <h1 class="text-3xl md:text-3xl font-extrabold tracking-tight text-neutral-100">
                            {title}
                        </h1>
                        <p class="text-xl md:text-xl text-neutral-300 leading-relaxed">
                            {description}
                        </p>
                        
                        <div class="h-px bg-neutral-800 my-10"></div>
                    </div>
                </div>

                <!-- Content -->
                <div class="prose prose-invert prose-xl max-w-none pb-24 
                            prose-headings:text-neutral-100 
                            prose-p:text-neutral-300 
                            prose-a:text-rose-400 prose-a:no-underline hover:prose-a:underline
                            prose-code:text-rose-500 prose-blockquote:border-l-rose-500">
                    <slot />
                </div>

                <!-- Comments Section -->
                <div class="max-w-4xl mx-auto py-16">
                    <div class="h-px bg-neutral-800 mb-16"></div>
                    <h2 class="text-2xl font-bold mb-8">Comments</h2>
                    <script src="https://giscus.app/client.js"
                        data-repo="ebdurrehm/ahmadov.tech"
                        data-repo-id="R_kgDONkDYKw"
                        data-category="General"
                        data-category-id="DIC_kwDONkDYK84CnVUh"
                        data-mapping="title"
                        data-strict="0"
                        data-reactions-enabled="1"
                        data-emit-metadata="0"
                        data-input-position="top"
                        data-theme="dark"
                        data-lang="en"
                        data-loading="lazy"
                        crossorigin="anonymous"
                        async>
                    </script>
                </div>

            </article>
        </main>
        <Footer />
    </body>
</html>
